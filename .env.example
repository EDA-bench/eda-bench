EDA_BENCH_AGENT_IMAGE=eda-bench-agent
# Set to 0 when HF storage should keep reports/logs but skip large Docker image tar uploads.
EDA_BENCH_UPLOAD_CONTAINER_IMAGES=1
# Set to 0 when HF storage should omit raw stdout/events from task bundles.
EDA_BENCH_UPLOAD_MODEL_TRANSCRIPTS=1
# Set to 0 to upload all task bundles in one final folder commit per harness.
EDA_BENCH_UPLOAD_TASK_BUNDLES_INCREMENTALLY=1
# Set to 0 to skip report.partial.json commits after each task.
EDA_BENCH_UPLOAD_PARTIAL_REPORTS=1
# Optional per-task Docker harness timeout in seconds.
EDA_BENCH_HARNESS_TIMEOUT_SECONDS=
HF_PROVENANCE_REPO_ID=your-org-or-user/eda-bench-provenance
HF_TOKEN=
CODEX_AUTH_JSON_B64=
# CODEX_CONFIG_TOML=
# PI harness API keys.
# Gemini accepts GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# DeepSeek V4 Pro is routed through Vercel AI Gateway as deepseek/deepseek-v4-pro.
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
# Optional pi-web-access search providers.
EXA_API_KEY=
PERPLEXITY_API_KEY=
# Optional: exa, gemini, or perplexity.
PI_WEB_SEARCH_PROVIDER=
